APP_NAME=RAG Agent API
API_V1_PREFIX=/api/v1
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-max
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_chunks
UPLOAD_DIR=./uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 混合检索：向量召回 + BM25 关键词召回，RRF 融合
HYBRID_ENABLED=true
HYBRID_CANDIDATE_K=20
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
# Query 改写：LLM 生成自包含查询和少量变体，空模型表示复用 CHAT_MODEL
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=
QUERY_REWRITE_MAX_VARIANTS=2
QUERY_REWRITE_MIN_CHARS=2
HYBRID_VARIANT_WEIGHT=0.5

# Rerank 默认关闭；开启前需要在百炼控制台开通对应的 rerank 模型。
# provider 可选 none / dashscope / local
RERANK_ENABLED=false
RERANK_PROVIDER=none
RERANK_MODEL=
RERANK_TOP_N=20
# DashScope Rerank 使用原生接口，可复用 OPENAI_API_KEY；也可以单独配置。
DASHSCOPE_API_KEY=
# 本地 CrossEncoder 方案（可选）
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_RERANK_DEVICE=
# langsmith配置信息
# 是否启用LangSmith监控功能
LANGSMITH_TRACING=true
# LangSmith监控 WebUI 地址
LANGSMITH_ENDPOINT=https://api.smith.LangChain.com
# 创建的 API_KEY
LANGSMITH_API_KEY=你的apikey
# 自定义项目名称，可以在 LangSmith webui 监控页面根据名称查看对应的运行记录
LANGSMITH_PROJECT="x_rag_agent"

# Docker Compose（可选）
# Compose 会启动自己的 Postgres/Redis，并用这些变量覆盖 DATABASE_URL/REDIS_URL
POSTGRES_USER=demo
POSTGRES_PASSWORD=local_demo_password
POSTGRES_DB=rag_agent
REDIS_PASSWORD=redis_password
# 宿主机端口；与本机开发服务冲突时可改为 8001/3001
API_PORT=8000
WEB_PORT=3000

# 认证
# 本地直连（不使用 docker compose）时填写下面两项：
# PostgreSQL：不要使用本地 SQLite；开发可用 Docker，生产用云托管
DATABASE_URL=postgresql+asyncpg://用户名:密码@127.0.0.1:5432/rag_agent
REDIS_URL=redis://:替换成强密码@127.0.0.1:6379/0
# 可选拼图功能使用；生产环境务必替换成随机值
AUTH_SECRET=替换成随机十六进制字符串
AUTH_CAPTCHA_TTL_S=180
AUTH_TICKET_TTL_S=120
AUTH_CAPTCHA_TOLERANCE_PX=5
AUTH_SESSION_TTL_S=604800
# 本地 http 开发用 false；生产 https 环境改为 true
AUTH_COOKIE_SECURE=false

# 会话摘要：达到 10 条消息后总结较早内容，保留最近 6 条原文
SUMMARY_ENABLED=true
SUMMARY_MODEL=
SUMMARY_TRIGGER_MESSAGES=10
SUMMARY_KEEP_MESSAGES=6
SUMMARY_MAX_CHARS=4000
SUMMARY_REQUEST_TIMEOUT_S=15
